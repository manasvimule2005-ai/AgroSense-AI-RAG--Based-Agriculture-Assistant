# AgroSense AI Configuration
# Supported providers: gemini, openai, anthropic, ollama, mock

LLM_PROVIDER=gemini

# Google Gemini (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Ollama (Optional - local instance URL)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Vector Store / RAG Tuning
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
